// Draft 1b: the instruction set
//
// The machine's state, how its instructions are encoded, and what each one
// does. RFC 0004, Part II, is the prose; this is the same thing, precise
// enough to run. studies/formal runs it on known values, against the
// instruction-level simulator, and on symbolic ones, against the hardware.
// The language is described in RFC 0038, Part II.
//
// Reading it: @name is the machine's state, everything else is local.
// uN is N bits, unsigned: comparisons, / and >> are unsigned, and signed
// operations say so (sext, asr, sdiv). x[7:0] is a slice and x[31] a bit;
// a ++ b puts a above b. 32'h0010_0000 is a 32-bit number; a bare number
// takes the type of what it meets, and must fit it. A fn works out a value
// and changes nothing; a proc may change state, fault or trap, and is
// called on its own, never inside an expression.


// ======================================================================
// State

register r[16]: u32         // general registers; r15 is the stack pointer
hardwired r[0] = 0          // r0 reads as 0, and writing it does nothing
register hi: u32            // the high word of a product, the remainder of a quotient
register pc: u32            // the next parcel to fetch; always even
flag N, Z, C, V             // negative, zero, carry, overflow
flag I                      // interrupts enabled
memory mem[u32]: u8         // bytes, little-endian

const SP: u4 = 15

const RAM_SIZE = 32'h0010_0000      // RAM is 0 to RAM_SIZE - 1
const IO_BASE = 32'hFFFF_FF00       // the I/O page is IO_BASE to the top

// Vectors: where a fault or trap goes (reset is at 0)
const VEC_IRQ = 32'h04
const VEC_ILLEGAL = 32'h08
const VEC_SWI = 32'h0C
const VEC_DIVIDE = 32'h10
const VEC_ADDRESS = 32'h14


// ======================================================================
// Executing an instruction
//
// An instruction is a first parcel of 16 bits, which says what it is,
// and up to two extension parcels after it. The PC moves past each parcel
// as it is read, so it is the next instruction's address by the time the
// instruction uses it (in relative branches and PC-relative addresses).
//
// `fault v` abandons the instruction (what it has done stays done) and
// enters vector v with the instruction's own address, so that it can be
// run again; `trap v` enters it with the next instruction's address.

proc step() {
    let p = parcel()
    decode p else {
        fault VEC_ILLEGAL                       // no instruction is encoded this way
    }
}

proc parcel() -> u16 {
    assume @pc < RAM_SIZE - 1, "code is in RAM"
    let p = @mem[@pc + 1] ++ @mem[@pc]
    @pc := @pc + 2
    return p
}

// A 32-bit constant: two parcels, the low half first.
proc imm32() -> u32 {
    let lo = parcel()
    let hi16 = parcel()
    return hi16 ++ lo
}

// Entering a fault, trap or interrupt: push the return address, then the
// flags, disable interrupts, and go to the vector.
proc enter(vector: u32, ret: u32) {
    assume @r[SP][1:0] == 0, "an aligned stack when entering a vector (else the simulator stops)"
    push(ret)
    push(flags_word())
    @I := false
    @pc := vector
}

// Interrupts are taken between instructions, not straight after EI, and
// HALT with I = 1 waits for one. Neither is part of this specification,
// which is of the instructions only.


// ======================================================================
// Memory
//
// A half must be at an even address and a word at a multiple of 4;
// anything else is an address error. RAM and the I/O page are all there
// is: the I/O page's registers (RFC 0004, section 26) aren't specified
// here, and an address in neither stops the simulator.

enum Size { Byte, Half, Word }

proc check(at: u32, size: Size) {
    match size {
        Size.Byte => {}
        Size.Half => if at[0] != 0 { fault VEC_ADDRESS }
        Size.Word => if at[1:0] != 0 { fault VEC_ADDRESS }
    }
    assume at < RAM_SIZE || at >= IO_BASE, "data in RAM or the I/O page (else the simulator stops)"
    assume at < RAM_SIZE, "not the I/O page, which this specification leaves out"
}

proc load(at: u32, size: Size) -> u32 {
    check(at, size)
    match size {
        Size.Byte => return zext(@mem[at], 32)
        Size.Half => return zext(@mem[at + 1] ++ @mem[at], 32)
        Size.Word => return @mem[at + 3] ++ @mem[at + 2] ++ @mem[at + 1] ++ @mem[at]
    }
}

proc store(at: u32, size: Size, value: u32) {
    check(at, size)
    @mem[at] := value[7:0]
    if size != Size.Byte {
        @mem[at + 1] := value[15:8]
    }
    if size == Size.Word {
        @mem[at + 2] := value[23:16]
        @mem[at + 3] := value[31:24]
    }
}

// The stack grows down; sp points at the last word pushed.
proc push(value: u32) {
    store(at: @r[SP] - 4, size: Size.Word, value: value)
    @r[SP] := @r[SP] - 4
}

proc pop() -> u32 {
    let value = load(@r[SP], Size.Word)
    @r[SP] := @r[SP] + 4
    return value
}


// ======================================================================
// Flags

// The flags word, as faults push it and MFSR reads it: I N Z C V in bits 4-0.
fn flags_word() -> u32 {
    return zext(bit(@I) ++ bit(@N) ++ bit(@Z) ++ bit(@C) ++ bit(@V), 32)
}

proc set_flags(word: u32) {
    @V := bool(word[0])
    @C := bool(word[1])
    @Z := bool(word[2])
    @N := bool(word[3])
    @I := bool(word[4])
}

// N and Z say what a result is. nz(x) sets them and gives x back, to be
// stored: @r[d] := nz(x).
proc set_nz(x: u32) {
    @N := bool(x[31])
    @Z := x == 0
}

proc nz(x: u32) -> u32 {
    set_nz(x)
    return x
}

// a + b + carry in: the sum, the carry out, and whether it overflowed as a
// signed sum. A subtraction is a + ~b + 1, so its carry means "no borrow".
record Sum { value: u32, carry: bool, overflow: bool }

fn add(a: u32, b: u32, carry: bool) -> Sum {
    let wide = zext(a, 33) + zext(b, 33) + zext(bit(carry), 33)
    let x = wide[31:0]
    return Sum {
        value: x,
        carry: bool(wide[32]),
        overflow: a[31] == b[31] && x[31] != a[31],
    }
}

// All four flags from a sum.
proc set_nzcv(s: Sum) {
    @C := s.carry
    @V := s.overflow
    set_nz(s.value)
}

proc nzcv(s: Sum) -> u32 {
    set_nzcv(s)
    return s.value
}

// The same with a sticky Z: it can be cleared but never set, so that the
// last of a chain of ADC or SBC says whether the whole result is zero.
proc nzcv_sticky(s: Sum) -> u32 {
    let z = @Z
    set_nzcv(s)
    @Z := @Z && z
    return s.value
}

// Condition codes: bits 3-1 pick a test, bit 0 inverts it.
//   0 EQ  1 NE  2 CS/HS  3 CC/LO  4 MI  5 PL  6 VS  7 VC
//   8 HI  9 LS  A GE     B LT     C GT  D LE  E always  (F: BSR and CALL)
fn condition(cc: u4) -> bool {
    let test = match cc[3:1] {
        0 => @Z,
        1 => @C,
        2 => @N,
        3 => @V,
        4 => @C && !@Z,
        5 => @N == @V,
        6 => !@Z && @N == @V,
        7 => true,
    }
    return test != bool(cc[0])
}


// ======================================================================
// Addressing modes
//
// The main format is F D M R: the operation, a register d, and the
// effective address (EA) of the other operand, mode m with register (or
// small constant) n. operand() decodes the EA, reading its extension
// parcels: a register's value, a constant, or a memory operand's address
// and size.

enum Kind { Reg, Imm, Mem }
record Operand { kind: Kind, value: u32, size: Size }      // Mem: value is the address

fn reg(value: u32) -> Operand {
    return Operand { kind: Kind.Reg, value: value, size: Size.Word }
}

fn imm(value: u32) -> Operand {
    return Operand { kind: Kind.Imm, value: value, size: Size.Word }
}

fn mem_at(at: u32, size: Size) -> Operand {
    return Operand { kind: Kind.Mem, value: at, size: size }
}

proc operand(m: u4, n: u4) -> Operand {
    match m {
        0x0 => return reg(@r[n])                                  // rn
        0x1 => return imm(zext(n, 32))                            // #n, 0 to 15
        0x2 => return mem_at(@r[n], Size.Word)                    // [rn]
        0x3 => return displaced(@r[n], Size.Word)                 // [rn + d16]
        0x4 => return mem_at(@r[SP] + (zext(n, 32) << 2), Size.Word)  // [sp + 4n], a stack slot
        0x5 => return indexed(n)                                    // [rn + rx * scale + d8]
        0x6 => return mem_at(@r[n], Size.Word)                    // [rn]+   (see update)
        0x7 => return mem_at(@r[n] - 4, Size.Word)                // -[rn]
        0x8 => return mem_at(@r[n], Size.Byte)                    // byte [rn]
        0x9 => return displaced(@r[n], Size.Byte)                 // byte [rn + d16]
        0xA => return mem_at(@r[n], Size.Byte)                    // byte [rn]+
        0xB => return mem_at(@r[n], Size.Half)                    // half [rn]
        0xC => return displaced(@r[n], Size.Half)                 // half [rn + d16]
        0xD => return imm(~zext(n, 32))                           // #-(n + 1), -1 to -16
        0xE => fault VEC_ILLEGAL                                    // reserved
        0xF => return special(n)
    }
}

// base + a signed 16-bit displacement from an extension parcel.
proc displaced(base: u32, size: Size) -> Operand {
    let d = parcel()
    return mem_at(base + sext(d, 32), size)
}

// Mode 5: the extension parcel is x s z dd: index register x, scale 1 << s,
// size z (byte, half, word; 3 is reserved) and a signed 8-bit displacement.
proc indexed(n: u4) -> Operand {
    let e = parcel()
    let z = e[9:8]
    if z == 3 {
        fault VEC_ILLEGAL
    }
    let size = match z { 0 => Size.Byte, 1 => Size.Half, _ => Size.Word }
    return mem_at(@r[n] + sext(e[7:0], 32) + (@r[e[15:12]] << e[11:10]), size)
}

// Mode F: operands that need no register, chosen by n. A PC-relative
// address is from the next instruction (the PC after the parcels).
proc special(n: u4) -> Operand {
    match n {
        0x0 => { let x = parcel(); return imm(sext(x, 32)) }                // #simm16
        0x1 => { let x = parcel(); return imm(zext(x, 32)) }                // #imm16
        0x2 => { let x = parcel(); return imm(zext(x, 32) << 16) }          // #imm16 << 16
        0x3 => { let x = imm32(); return imm(x) }                           // #imm32
        0x4 => { let a = parcel(); return mem_at(sext(a, 32), Size.Word) }  // [abs16], sign-extended
        0x5 => { let a = parcel(); return mem_at(sext(a, 32), Size.Byte) }  // byte [abs16]
        0x6 => { let a = parcel(); return mem_at(sext(a, 32), Size.Half) }  // half [abs16]
        0x7 => { let a = imm32(); return mem_at(a, Size.Word) }             // [abs32]
        0x8 => { let a = imm32(); return mem_at(a, Size.Byte) }             // byte [abs32]
        0x9 => { let a = imm32(); return mem_at(a, Size.Half) }             // half [abs32]
        0xA => { let d = parcel(); return mem_at(@pc + sext(d, 32), Size.Word) }  // [pc + d16]
        0xB => { let d = parcel(); return mem_at(@pc + sext(d, 32), Size.Byte) }  // byte [pc + d16]
        0xC => { let d = parcel(); return mem_at(@pc + sext(d, 32), Size.Half) }  // half [pc + d16]
        _ => fault VEC_ILLEGAL                                              // D to F are reserved
    }
}

// After the access, the auto-increment and auto-decrement modes write
// their register back.
proc update(m: u4, n: u4, op: Operand) {
    match m {
        0x6 => @r[n] := op.value + 4                                      // [rn]+
        0x7 => @r[n] := op.value                                          // -[rn]
        0xA => @r[n] := op.value + 1                                      // byte [rn]+
        _ => {}
    }
}

// An EA's value: a memory operand is read (bytes and halves zero-extended)
// and its register updated.
proc source(m: u4, n: u4) -> u32 {
    let op = operand(m: m, n: n)
    if op.kind != Kind.Mem {
        return op.value
    }
    let x = load(op.value, op.size)
    update(m: m, n: n, op: op)
    return x
}


// ======================================================================
// The EA instructions: ops 1 to 9 and B
//
// The register operand is read after the EA, so after any update of the
// EA's register: ADD r1, [r1]+ adds the incremented r1.

instruction "MOV rd, ea"  0001 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nz(x)
}

instruction "ST rd, ea"  0010 dddd mmmm nnnn {
    let x = @r[d]                               // before the EA's register changes
    let op = operand(m: m, n: n)
    if op.kind != Kind.Mem {
        fault VEC_ILLEGAL                       // only memory operands
    }
    store(at: op.value, size: op.size, value: x)
    update(m: m, n: n, op: op)
}

instruction "LEA rd, ea"  0011 dddd mmmm nnnn {
    if m == 0x6 || m == 0x7 || m == 0xA {
        fault VEC_ILLEGAL                       // not the updating modes
    }
    let op = operand(m: m, n: n)
    if op.kind != Kind.Mem {
        fault VEC_ILLEGAL
    }
    @r[d] := op.value
}

instruction "ADD rd, ea"  0100 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nzcv(add(a: @r[d], b: x, carry: false))
}

instruction "SUB rd, ea"  0101 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nzcv(add(a: @r[d], b: ~x, carry: true))
}

instruction "CMP rd, ea"  0110 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    set_nzcv(add(a: @r[d], b: ~x, carry: true))
}

instruction "AND rd, ea"  0111 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nz(@r[d] & x)
}

instruction "OR rd, ea"  1000 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nz(@r[d] | x)
}

instruction "XOR rd, ea"  1001 dddd mmmm nnnn {
    let x = source(m: m, n: n)
    @r[d] := nz(@r[d] ^ x)
}

// JMP and CALL take the EA's value as the target, like a MOV into the PC:
// JMP r3 goes to the address in r3, JMP [r3 + 8] to the one stored there.
// A memory operand must be a word.
instruction "JMP ea / CALL ea"  1011 kkkk mmmm nnnn {
    if k > 1 {
        fault VEC_ILLEGAL                       // k = 0 JMP, 1 CALL
    }
    let op = operand(m: m, n: n)
    var target = op.value
    if op.kind == Kind.Mem {
        if op.size != Size.Word {
            fault VEC_ILLEGAL
        }
        target := load(op.value, Size.Word)
        update(m: m, n: n, op: op)
    }
    if k == 1 {
        push(@pc)
    }
    @pc := target & ~1
}


// ======================================================================
// Branches and jumps

// Bcc: PC + 2 * simm8; c = 15 is BSR, a call.
instruction "Bcc target / BSR target"  1110 cccc iiii iiii {
    let target = @pc + (sext(i, 32) << 1)
    if c == 15 {
        push(@pc)
        @pc := target
    } else if condition(c) {
        @pc := target
    }
}

// Jcc, JMP (c = 14) and CALL (c = 15) with k = 0: PC + 2 * simm16 from one
// extension parcel; k = 1: an absolute address in two.
instruction "Jcc target / JMP target / CALL target"  1010 cccc kkkk 0000 {
    if k > 1 {
        fault VEC_ILLEGAL
    }
    var target: u32 = 0
    if k == 0 {
        let d = parcel()
        target := @pc + (sext(d, 32) << 1)
    } else {
        let a = imm32()
        target := a & ~1
    }
    if c == 15 {
        push(@pc)
        @pc := target
    } else if c == 14 || condition(c) {
        @pc := target
    }
}


// ======================================================================
// Unary group, op C: rd <- f(rs)

instruction "NOT rd, rs"  1100 dddd ssss 0000 {
    @r[d] := nz(~@r[s])
}

instruction "NEG rd, rs"  1100 dddd ssss 0001 {
    @r[d] := nzcv(add(a: 0, b: ~@r[s], carry: true))
}

instruction "INC rd, rs"  1100 dddd ssss 0010 {
    @r[d] := nz(@r[s] + 1)                      // N and Z only, unlike ADD #1
}

instruction "DEC rd, rs"  1100 dddd ssss 0011 {
    @r[d] := nz(@r[s] - 1)
}

instruction "RLC rd, rs"  1100 dddd ssss 0100 {
    let x = @r[s]
    let y = x[30:0] ++ bit(@C)
    @C := bool(x[31])
    @V := false
    @r[d] := nz(y)
}

instruction "RRC rd, rs"  1100 dddd ssss 0101 {
    let x = @r[s]
    let y = bit(@C) ++ x[31:1]
    @C := bool(x[0])
    @V := false
    @r[d] := nz(y)
}

instruction "SWAP rd, rs"  1100 dddd ssss 0110 {
    let x = @r[s]
    @r[d] := nz(x[15:0] ++ x[31:16])
}

instruction "SXB rd, rs"  1100 dddd ssss 0111 {
    @r[d] := nz(sext(@r[s][7:0], 32))
}

instruction "ZXB rd, rs"  1100 dddd ssss 1000 {
    @r[d] := nz(zext(@r[s][7:0], 32))
}

instruction "SXH rd, rs"  1100 dddd ssss 1001 {
    @r[d] := nz(sext(@r[s][15:0], 32))
}

instruction "ZXH rd, rs"  1100 dddd ssss 1010 {
    @r[d] := nz(zext(@r[s][15:0], 32))
}

instruction "CLZ rd, rs"  1100 dddd ssss 1011 {
    let x = @r[s]
    var count: u32 = 32                         // the leading zero bits, 0 to 32
    for b: u5 in 0 ..= 31 {
        if x[b] == 1 {
            count := 31 - zext(b, 32)
        }
    }
    @r[d] := nz(count)
}


// ======================================================================
// Shift group, op D: in place on rd, by a constant n (0 to 31, its top
// bit h) or by rs (its low 5 bits). C is the last bit shifted out (for
// ROR, the new bit 31), unchanged for a count of 0; V is cleared.

instruction "LSL rd, #n"  1101 dddd nnnn 0h00 {
    @r[d] := shift_left(@r[d], h ++ n)
}

instruction "LSR rd, #n"  1101 dddd nnnn 0h01 {
    @r[d] := shift_right(@r[d], h ++ n)
}

instruction "ASR rd, #n"  1101 dddd nnnn 0h10 {
    @r[d] := shift_arith(@r[d], h ++ n)
}

instruction "ROR rd, #n"  1101 dddd nnnn 0h11 {
    @r[d] := rotate(@r[d], h ++ n)
}

instruction "LSL rd, rs"  1101 dddd ssss 1000 {
    @r[d] := shift_left(@r[d], @r[s][4:0])
}

instruction "LSR rd, rs"  1101 dddd ssss 1001 {
    @r[d] := shift_right(@r[d], @r[s][4:0])
}

instruction "ASR rd, rs"  1101 dddd ssss 1010 {
    @r[d] := shift_arith(@r[d], @r[s][4:0])
}

instruction "ROR rd, rs"  1101 dddd ssss 1011 {
    @r[d] := rotate(@r[d], @r[s][4:0])
}

proc shift_left(x: u32, count: u5) -> u32 {
    if count != 0 {
        @C := bool((x >> (32 - zext(count, 32)))[0])
    }
    @V := false
    return nz(x << count)
}

proc shift_right(x: u32, count: u5) -> u32 {
    if count != 0 {
        @C := bool((x >> (zext(count, 32) - 1))[0])
    }
    @V := false
    return nz(x >> count)
}

proc shift_arith(x: u32, count: u5) -> u32 {
    if count != 0 {
        @C := bool(asr(x, zext(count, 32) - 1)[0])
    }
    @V := false
    return nz(asr(x, count))
}

proc rotate(x: u32, count: u5) -> u32 {
    let y = ror(x, count)
    if count != 0 {
        @C := bool(y[31])
    }
    @V := false
    return nz(y)
}


// ======================================================================
// Register-only ALU functions, op F: rd <- rd op rs. f = 9 to F is illegal.

instruction "ADC rd, rs"  1111 dddd ssss 0000 {
    @r[d] := nzcv_sticky(add(a: @r[d], b: @r[s], carry: @C))
}

instruction "SBC rd, rs"  1111 dddd ssss 0001 {
    @r[d] := nzcv_sticky(add(a: @r[d], b: ~@r[s], carry: @C))
}

instruction "BIC rd, rs"  1111 dddd ssss 0010 {
    @r[d] := nz(@r[d] & ~@r[s])
}

instruction "TST rd, rs"  1111 dddd ssss 0011 {
    set_nz(@r[d] & @r[s])
}

// Multiplies: HI:rd <- rd * rs, a 64-bit product. C and V say it didn't fit
// in 32 bits.
instruction "MULU rd, rs"  1111 dddd ssss 0100 {
    let p = zext(@r[d], 64) * zext(@r[s], 64)
    @hi := p[63:32]
    @C := p[63:32] != 0
    @V := @C
    @r[d] := nz(p[31:0])
}

instruction "MULS rd, rs"  1111 dddd ssss 0101 {
    let p = sext(@r[d], 64) * sext(@r[s], 64)
    @hi := p[63:32]
    @C := p != sext(p[31:0], 64)
    @V := @C
    @r[d] := nz(p[31:0])
}

// Divides: rd <- quotient, HI <- remainder. Dividing by zero is a fault,
// with everything unchanged.
instruction "DIVU rd, rs"  1111 dddd ssss 0110 {
    let a = @r[d]
    let b = @r[s]
    if b == 0 {
        fault VEC_DIVIDE
    }
    @hi := a % b
    @C := false
    @V := false
    @r[d] := nz(a / b)
}

// Rounded toward zero; the remainder has the dividend's sign. -2^31 / -1
// overflows: it gives -2^31, remainder 0, and sets V.
instruction "DIVS rd, rs"  1111 dddd ssss 0111 {
    let a = @r[d]
    let b = @r[s]
    if b == 0 {
        fault VEC_DIVIDE
    }
    @C := false
    if a == 32'h8000_0000 && b == 32'hFFFF_FFFF {
        @hi := 0
        @V := true
        @r[d] := nz(a)
    } else {
        @hi := srem(a, b)
        @V := false
        @r[d] := nz(sdiv(a, b))
    }
}

// HI:rd / rs. If the quotient wouldn't fit (HI >= rs), V is set and
// nothing else changes, so a chain of them divides a bignum by a word.
instruction "DIVUL rd, rs"  1111 dddd ssss 1000 {
    let b = @r[s]
    if b == 0 {
        fault VEC_DIVIDE
    }
    if @hi >= b {
        @V := true
    } else {
        let n = @hi ++ @r[d]
        @hi := (n % zext(b, 64))[31:0]
        @C := false
        @V := false
        @r[d] := nz((n / zext(b, 64))[31:0])
    }
}


// ======================================================================
// System group, op 0: 0 a b f

instruction "HALT"  0000 ---- ---- 0000 {
    halt                                        // stop (or wait for an interrupt)
}

instruction "NOP"  0000 ---- ---- 0001 {
}

instruction "JMP rs"  0000 ---- ssss 0010 {
    @pc := @r[s] & ~1
}

instruction "CALL rs"  0000 ---- ssss 0011 {
    let target = @r[s] & ~1
    push(@pc)
    @pc := target
}

instruction "RET"  0000 ---- ---- 0100 {
    let target = pop()
    @pc := target & ~1
}

// SAVE ra-rb pushes ra to rb, ra lowest: sp <- sp - 4n, then ra at [sp],
// ra+1 at [sp + 4] and so on.
instruction "SAVE ra-rb"  0000 aaaa bbbb 0101  when 1 <= a && a <= b && b <= 14 {
    let base = @r[SP] - (zext(b - a + 1, 32) << 2)
    for k: u4 in a ..= b {
        store(at: base + (zext(k - a, 32) << 2), size: Size.Word, value: @r[k])
    }
    @r[SP] := base
}

// RESTORE ra-rb: the reverse, sp <- sp + 4n after. All the words are read
// before any register changes, so a fault leaves them as they were (they
// are all aligned or none is).
instruction "RESTORE ra-rb"  0000 aaaa bbbb 0110  when 1 <= a && a <= b && b <= 14 {
    let base = @r[SP]
    check(base, Size.Word)
    for k: u4 in a ..= b {
        @r[k] := load(base + (zext(k - a, 32) << 2), Size.Word)
    }
    @r[SP] := base + (zext(b - a + 1, 32) << 2)
}

instruction "RTI"  0000 ---- ---- 0111 {
    let word = pop()
    set_flags(word)
    let target = pop()
    @pc := target & ~1
}

instruction "EI"  0000 ---- ---- 1000 {
    @I := true
}

instruction "DI"  0000 ---- ---- 1001 {
    @I := false
}

// Special registers: 0 is the flags word, 1 is HI.
instruction "MFSR rd, n"  0000 dddd nnnn 1010  when n <= 1 {
    if n == 0 {
        @r[d] := flags_word()
    } else {
        @r[d] := @hi
    }
}

instruction "MTSR n, rs"  0000 nnnn ssss 1011  when n <= 1 {
    if n == 0 {
        set_flags(@r[s])
    } else {
        @hi := @r[s]
    }
}

// The handler finds the number in the instruction at [saved PC - 2].
instruction "SWI #n"  0000 nnnn nnnn 1100 {
    trap VEC_SWI
}

instruction "SETcc rd"  0000 dddd cccc 1101  when c != 15 {
    @r[d] := zext(bit(condition(c)), 32)
}
