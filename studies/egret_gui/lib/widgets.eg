# A window of editable text in DejaVu Sans Mono: lines, a cursor, a
# selection, the keyboard and the mouse, and as little drawing as it can
# get away with (a keystroke redraws one line). The Workspace and the
# Transcript are made of it.

CLIPBOARD = ""

def left_of(s, n) = if n <= 0 then "" else s[0..(n - 1)] end
def right_of(s, n) = if n >= s.size then "" else s[n..(s.size - 1)] end
def word_char?(c) = c.letter? or c.digit? or c == "_" or c == "?" or c == "!"

class TextWindow < Window
  def init(title, x, y, w, h, text)
    @bg = PAL.white
    @lines = self.split_lines(text)
    @row = 0
    @col = 0
    @anchor = nil                       # where the selection started: [row, col]
    @top = 0                            # the first line on show
    @editable = true
    @cw = gui_text_width("M", MONO)
    info = gui_font_info(MONO)
    @ascent = info[0]
    @lh = info[2] + 1
    @mx = 4                             # the margins
    @my = 3
    super(title, x, y, w, h)
  end
  attr row, col

  def split_lines(text)
    out = text.split("\n")
    if out.size == 0 or (text.ends_with?("\n") and out.last != "") then out.push("") end
    out
  end

  def text = @lines.join("\n")
  def set_text(t)
    @lines = self.split_lines(t)
    @row = 0
    @col = 0
    @anchor = nil
    @top = 0
    self.invalidate
  end
  def line_count = @lines.size

  # ---- geometry

  def rows_shown = ((self.height - 2 * @my) / @lh).max(1)
  def line_y(i) = @my + (i - @top) * @lh
  def shown?(i) = i >= @top and i < @top + self.rows_shown + 1

  def pos_at(x, y)
    r = (@top + (y - @my) / @lh).max(0).min(@lines.size - 1)
    c = ((x - @mx + @cw / 2) / @cw).max(0).min(@lines[r].size)
    [r, c]
  end

  def pointer_at(x, y) = P_TEXT

  # ---- the selection: [r0, c0, r1, c1] in order, or nil

  def selection
    if @anchor == nil then return nil end
    a = @anchor
    if a[0] == @row and a[1] == @col then return nil end
    if a[0] < @row or (a[0] == @row and a[1] < @col)
      [a[0], a[1], @row, @col]
    else
      [@row, @col, a[0], a[1]]
    end
  end

  def selected_text
    s = self.selection
    if s == nil then return "" end
    if s[0] == s[2] then return @lines[s[0]][s[1]..(s[3] - 1)] end
    parts = [right_of(@lines[s[0]], s[1])]
    i = s[0] + 1
    while i < s[2]
      parts.push(@lines[i])
      i += 1
    end
    parts.push(left_of(@lines[s[2]], s[3]))
    parts.join("\n")
  end

  def select_all
    @anchor = [0, 0]
    @row = @lines.size - 1
    @col = @lines[@row].size
    self.redraw_from(@top)
  end

  # ---- drawing

  def paint
    i = @top
    last = (@top + self.rows_shown).min(@lines.size - 1)
    while i <= last
      self.draw_line(i)
      i += 1
    end
  end

  def draw_line(i)
    if not self.shown?(i) then return nil end
    y = self.line_y(i)
    self.fill(0, y, self.width, @lh, @bg)
    if i >= @lines.size then return nil end
    s = @lines[i]
    base = y + @ascent
    sel = self.selection
    if sel != nil and i >= sel[0] and i <= sel[2]
      a = if i == sel[0] then sel[1] else 0 end
      b = if i == sel[2] then sel[3] else s.size + 1 end
      self.fill(@mx + a * @cw, y, (b - a) * @cw, @lh, PAL.select)
      gui_text(@id, @mx, base, s, PAL.text, PAL.select, MONO)
      if not PAL.color?
        gui_text(@id, @mx + a * @cw, base, s[a..(b - 1)], PAL.select_text, PAL.select, MONO)
      end
    else
      gui_text(@id, @mx, base, s, PAL.text, @bg, MONO)
      if i == @row and @editable
        self.fill(@mx + @col * @cw - 1, y, 2, @lh, PAL.accent)
      end
    end
  end

  # the lines from i to the bottom, and what's below the last
  def redraw_from(i)
    i = i.max(@top)
    last = @top + self.rows_shown
    while i <= last
      self.draw_line(i)
      i += 1
    end
  end

  def scroll_to(t)
    t = t.max(0).min((@lines.size - 1).max(0))
    d = t - @top
    if d == 0 then return nil end
    @top = t
    shown = self.rows_shown
    if d.abs >= shown
      self.invalidate
    else
      self.scroll(0, @my, self.width, shown * @lh + @lh, d * @lh)
    end
  end

  def ensure_visible
    shown = self.rows_shown
    if @row < @top
      self.scroll_to(@row)
    elif @row >= @top + shown
      self.scroll_to(@row - shown + 1)
    end
  end

  # move the cursor (extending the selection if `extend`), redrawing
  # what changes
  def goto(r, c, extend)
    old_sel = self.selection
    old_row = @row
    if extend
      if @anchor == nil then @anchor = [@row, @col] end
    else
      @anchor = nil
    end
    @row = r
    @col = c
    new_sel = self.selection
    lo = old_row.min(r)
    hi = old_row.max(r)
    if old_sel != nil
      lo = lo.min(old_sel[0])
      hi = hi.max(old_sel[2])
    end
    if new_sel != nil
      lo = lo.min(new_sel[0])
      hi = hi.max(new_sel[2])
    end
    self.ensure_visible
    i = lo
    while i <= hi
      self.draw_line(i)
      i += 1
    end
  end

  # ---- editing

  def delete_selection
    s = self.selection
    if s == nil
      @anchor = nil                     # (a click leaves one, for dragging)
      return false
    end
    @lines[s[0]] = left_of(@lines[s[0]], s[1]) + right_of(@lines[s[2]], s[3])
    k = s[2] - s[0]
    while k > 0
      @lines.delete_at(s[0] + 1)
      k -= 1
    end
    @row = s[0]
    @col = s[1]
    @anchor = nil
    true
  end

  def insert(str)
    many = self.delete_selection
    start = @row
    for ch in str.chars
      if ch == "\n"
        line = @lines[@row]
        @lines[@row] = left_of(line, @col)
        @lines.insert(@row + 1, right_of(line, @col))
        @row += 1
        @col = 0
        many = true
      else
        line = @lines[@row]
        @lines[@row] = left_of(line, @col) + ch + right_of(line, @col)
        @col += 1
      end
    end
    self.ensure_visible
    if many then self.redraw_from(start) else self.draw_line(@row) end
  end

  def backspace
    if self.delete_selection
      self.redraw_from(@row)
    elif @col > 0
      line = @lines[@row]
      @lines[@row] = left_of(line, @col - 1) + right_of(line, @col)
      @col -= 1
      self.draw_line(@row)
    elif @row > 0
      @col = @lines[@row - 1].size
      @lines[@row - 1] = @lines[@row - 1] + @lines[@row]
      @lines.delete_at(@row)
      @row -= 1
      self.ensure_visible
      self.redraw_from(@row)
    end
  end

  def delete_forward
    if self.delete_selection
      self.redraw_from(@row)
    elif @col < @lines[@row].size
      line = @lines[@row]
      @lines[@row] = left_of(line, @col) + right_of(line, @col + 1)
      self.draw_line(@row)
    elif @row < @lines.size - 1
      @lines[@row] = @lines[@row] + @lines[@row + 1]
      @lines.delete_at(@row + 1)
      self.redraw_from(@row)
    end
  end

  def newline
    indent = 0
    line = @lines[@row]
    while indent < line.size and line[indent] == " "
      indent += 1
    end
    self.insert("\n" + " " * indent.min(@col))
  end

  def key(code, mods)
    shift = mods & M_SHIFT != 0
    if mods & M_COMMAND != 0
      self.command(code, mods)
      return nil
    end
    if code == K_LEFT
      if @col > 0
        self.goto(@row, @col - 1, shift)
      elif @row > 0
        self.goto(@row - 1, @lines[@row - 1].size, shift)
      end
    elif code == K_RIGHT
      if @col < @lines[@row].size
        self.goto(@row, @col + 1, shift)
      elif @row < @lines.size - 1
        self.goto(@row + 1, 0, shift)
      end
    elif code == K_UP
      if @row > 0 then self.goto(@row - 1, @col.min(@lines[@row - 1].size), shift) end
    elif code == K_DOWN
      if @row < @lines.size - 1 then self.goto(@row + 1, @col.min(@lines[@row + 1].size), shift) end
    elif code == K_HOME
      self.goto(@row, 0, shift)
    elif code == K_END
      self.goto(@row, @lines[@row].size, shift)
    elif code == K_PAGEUP
      r = (@row - self.rows_shown).max(0)
      self.goto(r, @col.min(@lines[r].size), shift)
    elif code == K_PAGEDOWN
      r = (@row + self.rows_shown).min(@lines.size - 1)
      self.goto(r, @col.min(@lines[r].size), shift)
    elif not @editable
      nil
    elif code == K_RETURN
      self.newline
    elif code == K_BACKSPACE
      self.backspace
    elif code == K_DELETE
      self.delete_forward
    elif code == K_TAB
      self.insert("  ")
    elif code >= 32 and code < 127
      self.insert(code.chr)
    end
  end

  # command keys (control or meta): a, c, x, v, and home and end for the
  # start and the end of the text
  def command(code, mods)
    if code == K_HOME
      self.goto(0, 0, mods & M_SHIFT != 0)
    elif code == K_END
      self.goto(@lines.size - 1, @lines[@lines.size - 1].size, mods & M_SHIFT != 0)
    elif code == 97
      self.select_all
    elif code == 99
      if self.selection != nil then CLIPBOARD = self.selected_text end
    elif code == 120 and @editable
      if self.selection != nil
        CLIPBOARD = self.selected_text
        self.delete_selection
        self.redraw_from(@row)
      end
    elif code == 118 and @editable
      self.insert(CLIPBOARD)
    end
  end

  def mouse_down(x, y, b)
    p = self.pos_at(x, y)
    self.goto(p[0], p[1], false)
    @anchor = [p[0], p[1]]
  end

  def mouse_drag(x, y)
    p = self.pos_at(x, y)
    if y < 0 and @top > 0
      p = [@top - 1, 0]
    elif y > self.height and @top + self.rows_shown < @lines.size
      r = @top + self.rows_shown
      p = [r, @lines[r].size]
    end
    if p[0] != @row or p[1] != @col then self.goto(p[0], p[1], true) end
  end

  # (where it's let go counts, if the drags fell behind)
  def mouse_up(x, y, b) = self.mouse_drag(x, y)

  def double_click(x, y)
    p = self.pos_at(x, y)
    line = @lines[p[0]]
    a = p[1]
    b = p[1]
    while a > 0 and word_char?(line[a - 1])
      a -= 1
    end
    while b < line.size and word_char?(line[b])
      b += 1
    end
    @anchor = nil
    self.goto(p[0], a, false)
    self.goto(p[0], b, true)
  end

  def wheel(delta)
    self.scroll_to(@top + 3 * delta)
  end

  def resized
    @top = @top.min((@lines.size - 1).max(0))
  end
end
