# The desktop's applications.

def short(s, n) = if s.size <= n then s else left_of(s, n - 3) + "..." end

# ---- the Workspace: Egret to run --------------------------------------------

class Workspace < TextWindow
  def init(text)
    p = DESK.place(400, 280)
    super("Workspace", p[0], p[1], 400, 280, text)
  end

  def command(code, mods)
    if code == 100
      self.do_it(false)
    elif code == 112
      self.do_it(true)
    else
      super(code, mods)
    end
  end

  def indented?(i) = @lines[i].size == 0 or @lines[i][0] == " "

  # What Ctrl-D runs with nothing selected, as [first row, last row]: the
  # line the cursor is on, or, if that's in a class or a def that ends
  # with an `end` of its own, all of it.
  def statement_at(r)
    s = r
    while s > 0 and (self.indented?(s) or @lines[s].strip == "end")
      s -= 1
    end
    first = @lines[s]
    if first.starts_with?("class ") or first.starts_with?("def ")
      e = s + 1
      while e < @lines.size and self.indented?(e)
        e += 1
      end
      if e < @lines.size and e >= r and @lines[e].strip == "end" then return [s, e] end
    end
    [r, r]
  end

  # Run the selection, or the statement the cursor is in. Print it puts
  # the value after the code, selected (so typing replaces it), and an
  # error goes there either way.
  def do_it(show)
    s = self.selection
    if s == nil
      rows = self.statement_at(@row)
      code = @lines[rows[0]..rows[1]].join("\n")
      at = [rows[1], @lines[rows[1]].size]
    else
      code = self.selected_text
      at = [s[2], s[3]]
    end
    gui_pointer(P_BUSY)
    r = DESK.evaluate(code)
    if r[0] and not show then return nil end
    if r[0]
      msg = " # => " + short(r[1].inspect, 120)
    else
      msg = " # error: " + short(r[1].replace("\n", "; "), 120)
    end
    self.goto(at[0], at[1], false)
    self.insert(msg)
    @anchor = [at[0], at[1]]
    self.draw_line(@row)
  end

  def menu_items = [
    ["Do it          Ctrl-D", { self.do_it(false) }],
    ["Print it       Ctrl-P", { self.do_it(true) }],
    "-",
    ["Cut", { self.command(120, M_CTRL) }],
    ["Copy", { self.command(99, M_CTRL) }],
    ["Paste", { self.command(118, M_CTRL) }],
    ["Select all", { self.select_all }]]
end

# ---- the Transcript: what's printed -----------------------------------------

class Transcript < TextWindow
  def init
    super("Transcript", 8, 352, 392, 118, "")
    @editable = false
  end

  def append(s)
    first = @lines.size - 1
    more = self.split_lines(s)
    @lines[first] = @lines[first] + more[0]
    i = 1
    while i < more.size
      @lines.push(more[i])
      i += 1
    end
    if @lines.size > 300
      k = @lines.size - 200
      @lines = @lines[k..(@lines.size - 1)]
      first = 0
      @top = (@top - k).max(0)
      self.invalidate
    end
    @anchor = nil
    @row = @lines.size - 1
    @col = @lines[@row].size
    self.ensure_visible
    self.redraw_from(first)
  end

  def menu_items = [
    ["Copy", { self.command(99, M_CTRL) }],
    ["Select all", { self.select_all }],
    ["Clear", { self.set_text("") }]]
end

# ---- a clock -----------------------------------------------------------------

# sin(6 degrees x i) x 1000, for a quarter turn
SINES = [0, 105, 208, 309, 407, 500, 588, 669, 743, 809, 866, 914, 951, 978, 995, 1000]

# the sine and cosine of i sixtieths of a turn, times 1000
def sin60(i)
  i = i % 60
  if i <= 15 then SINES[i] elif i <= 30 then SINES[30 - i] elif i <= 45 then -SINES[i - 30] else -SINES[60 - i] end
end
def cos60(i) = sin60(i + 15)

class Clock < Window
  def init(x, y)
    @shown = nil
    super("Clock", x, y, 132, 132)
    DESK.start_ticks(self)
  end
  def resizable? = false

  def paint
    cx = self.width / 2
    cy = self.height / 2
    r = cx.min(cy) - 6
    self.fill_oval(cx, cy, r, r, PAL.white)
    self.oval(cx, cy, r, r, PAL.black)
    i = 0
    while i < 60
      inner = if i % 5 == 0 then r - 8 else r - 3 end
      self.line(cx + sin60(i) * inner / 1000, cy - cos60(i) * inner / 1000,
                cx + sin60(i) * (r - 1) / 1000, cy - cos60(i) * (r - 1) / 1000, PAL.black)
      i += 1
    end
    if @shown != nil then self.hands(@shown, false) end
  end

  # a hand pointing at i sixtieths, len long and w wide
  def hand(i, len, w, c)
    cx = self.width / 2
    cy = self.height / 2
    tip = [cx + sin60(i) * len / 1000, cy - cos60(i) * len / 1000]
    tail = [cx - sin60(i) * 8 / 1000, cy + cos60(i) * 8 / 1000]
    side = [sin60(i + 15) * w / 1000, -cos60(i + 15) * w / 1000]
    self.poly([tip[0], tip[1], cx + side[0], cy + side[1], tail[0], tail[1], cx - side[0], cy - side[1]], c)
  end

  def hands(t, erase)
    cx = self.width / 2
    cy = self.height / 2
    r = cx.min(cy) - 6
    h = t / 3600 % 12
    m = t / 60 % 60
    s = t % 60
    ink = if erase then PAL.white else PAL.black end
    self.hand(h * 5 + m / 12, r * 5 / 10, 4, ink)
    self.hand(m, r * 8 / 10, 3, ink)
    self.line(cx, cy, cx + sin60(s) * (r - 10) / 1000, cy - cos60(s) * (r - 10) / 1000,
              if erase then PAL.white else PAL.red end)
    self.fill_oval(cx, cy, 2, 2, if erase then PAL.white else PAL.red end)
  end

  def tick(ticks)
    t = gui_time()
    if t == @shown then return nil end
    if @shown != nil then self.hands(@shown, true) end
    @shown = t
    self.hands(t, false)
  end
end

# ---- Life -----------------------------------------------------------------------

GOSPER = [[24, 0], [22, 1], [24, 1], [12, 2], [13, 2], [20, 2], [21, 2], [34, 2], [35, 2],
          [11, 3], [15, 3], [20, 3], [21, 3], [34, 3], [35, 3], [0, 4], [1, 4], [10, 4],
          [16, 4], [20, 4], [21, 4], [0, 5], [1, 5], [10, 5], [14, 5], [16, 5], [17, 5],
          [22, 5], [24, 5], [10, 6], [16, 6], [24, 6], [11, 7], [15, 7], [12, 8], [13, 8]]

class Life < Window
  def init
    @cols = 64
    @rows = 40
    @size = 5
    n = @cols * @rows
    @alive = List.new(n)
    @counts = List.new(n)
    i = 0
    while i < n
      @alive[i] = 0
      @counts[i] = 0
      i += 1
    end
    @live = []
    @gen = 0
    @running = true
    self.gun
    p = DESK.place(@cols * @size, @rows * @size + 16)
    super("Life", p[0], p[1], @cols * @size, @rows * @size + 16)
    DESK.start_ticks(self)
  end
  def resizable? = false
  def generation = @gen

  def gun
    self.clear_cells
    for c in GOSPER
      self.set(c[1] + 4, c[0] + 2, 1)
    end
  end

  def soup
    self.clear_cells
    seed = gui_ticks() * 7919 + 1
    i = 0
    while i < @cols * @rows / 5
      seed = (seed * 1103515245 + 12345) % 2147483648
      self.set((seed / 65536) % @rows, (seed / 16) % @cols, 1)
      i += 1
    end
  end

  def clear_cells
    for i in @live
      @alive[i] = 0
    end
    @live = []
    @gen = 0
  end

  def set(r, c, v)
    i = r * @cols + c
    if @alive[i] == v then return nil end
    @alive[i] = v
    if v == 1
      @live.push(i)
    else
      @live.delete_at(@live.index(i))
    end
  end

  def draw_cell(i)
    x = i % @cols * @size
    y = i / @cols * @size
    c = if @alive[i] == 1 then PAL.blue else PAL.white end
    self.fill(x, y, @size - 1, @size - 1, c)
  end

  def status
    y = @rows * @size
    self.fill(0, y, self.width, 16, PAL.light)
    s = "generation {@gen}, {@live.size} cells"
    if not @running then s = s + " (paused)" end
    self.text(4, y + 12, s, PAL.black)
  end

  def paint
    self.fill(0, 0, self.width, @rows * @size, PAL.white)
    for i in @live
      self.draw_cell(i)
    end
    self.status
  end

  # count the neighbours of the live cells: only those can change
  def step
    cols = @cols
    n = cols * @rows
    counts = @counts
    touched = []
    for i in @live
      x = i % cols
      up = if i < cols then i - cols + n else i - cols end
      down = if i + cols >= n then i + cols - n else i + cols end
      l = if x == 0 then cols - 1 else -1 end
      r = if x == cols - 1 then 1 - cols else 1 end
      for j in [up + l, up, up + r, i + l, i + r, down + l, down, down + r]
        if counts[j] == 0 then touched.push(j) end
        counts[j] += 1
      end
    end
    alive = @alive
    born = []
    keep = []
    for j in touched
      c = counts[j]
      if c == 3 or (c == 2 and alive[j] == 1)
        if alive[j] == 0 then born.push(j) else keep.push(j) end
      end
      counts[j] = 0
    end
    # the dead are the live cells not kept
    for j in keep
      counts[j] = 1
    end
    died = @live.select { |i| counts[i] == 0 }
    for j in keep
      counts[j] = 0
    end
    for j in died
      alive[j] = 0
      self.draw_cell(j)
    end
    for j in born
      alive[j] = 1
      self.draw_cell(j)
    end
    @live = keep + born
    @gen += 1
  end

  def tick(t)
    if @running
      self.step
      if @gen % 4 == 0 then self.status end
    end
  end

  def mouse_down(x, y, b)
    r = y / @size
    c = x / @size
    if r < @rows and c < @cols
      i = r * @cols + c
      self.set(r, c, 1 - @alive[i])
      self.draw_cell(i)
    else
      @running = not @running
      self.status
    end
  end

  def menu_items = [
    [if @running then "Pause" else "Run" end, { @running = not @running
                                               self.status }],
    ["Step", { self.step
               self.status }],
    "-",
    ["Glider gun", { self.gun
                     self.invalidate }],
    ["Random soup", { self.soup
                      self.invalidate }],
    ["Clear", { self.clear_cells
                self.invalidate }]]
end

# ---- the Mandelbrot set, in 4.12 fixed point ------------------------------------

# blue through white to orange, for the number of steps to escape
MANDEL_RGB = [[0, 7, 100], [12, 44, 138], [24, 82, 177], [57, 125, 209], [134, 181, 229],
              [211, 236, 248], [241, 233, 191], [248, 201, 95], [255, 170, 0], [204, 128, 0],
              [153, 87, 0], [106, 52, 3], [66, 30, 15], [25, 7, 26], [9, 1, 47], [4, 4, 73]]

class Mandel < Window
  def init
    @mw = 160
    @mh = 120
    @limit = 32
    @colors = self.make_colors
    self.reset
    p = DESK.place(@mw, @mh + 16)
    super("Mandelbrot", p[0], p[1], @mw, @mh + 16)
    DESK.start_ticks(self)
  end
  def resizable? = false

  def make_colors
    ramp = if PAL.color? then MANDEL_RGB.map { |c| PAL.rgb(c[0], c[1], c[2]) } else [PAL.white, PAL.black] end
    out = []
    i = 0
    while i < @limit
      out.push(ramp[i % ramp.size].chr)
      i += 1
    end
    out.push(PAL.black.chr)
    out
  end

  def reset
    @step = 7 * 4096 / 2 / @mw         # 3.5 across
    @x0 = -2 * 4096 - 2048             # -2.5
    @y0 = -(@mh / 2) * @step
    self.restart
  end

  def restart
    # rows in passes of 8, 4, 2 and 1 rows apart, each drawn as tall as the gap
    @order = []
    for gap in [8, 4, 2, 1]
      y = 0
      while y < @mh
        if gap == 8 or y % (2 * gap) != 0 then @order.push([y, gap]) end
        y += gap
      end
    end
    @next = 0
    @x = 0
    @row = []
    @rows = List.new(@mh)               # what's been drawn, to paint again
    @started = gui_ticks()
  end

  # the colour of one point: how many steps z = z^2 + c takes to escape
  def point(cr, ci)
    zr = 0
    zi = 0
    n = 0
    limit = @limit
    while n < limit
      rr = (zr * zr) >> 12
      ii = (zi * zi) >> 12
      if rr + ii > 16384 then return @colors[n] end
      zi = ((zr * zi) >> 11) + ci
      zr = rr - ii + cr
      n += 1
    end
    @colors[limit]
  end

  # as many points as fit in a few hundredths of a second, so the desktop
  # stays awake; each row drawn when it's done
  def tick(t)
    if @next >= @order.size then return nil end
    start = clock()
    while clock() - start < 40000
      job = @order[@next]
      ci = @y0 + job[0] * @step
      @row.push(self.point(@x0 + @x * @step, ci))
      @x += 1
      if @x == @mw
        px = @row.join("")
        k = 0
        while k < job[1] and job[0] + k < @mh
          self.pixels(0, job[0] + k, px)
          @rows[job[0] + k] = px
          k += 1
        end
        @x = 0
        @row = []
        @next += 1
        if @next % 8 == 0 or @next == @order.size then self.status end
        if @next >= @order.size
          print("Mandelbrot: drawn in {(gui_ticks() - @started) / 6 / 10}.{(gui_ticks() - @started) / 6 % 10} s")
          return nil
        end
      end
    end
  end

  def status
    y = @mh
    self.fill(0, y, self.width, 16, PAL.light)
    s = if @next >= @order.size
      "{(gui_ticks() - @started + 30) / 60} s; click to zoom in"
    else
      "drawing: {@next * 100 / @order.size}%"
    end
    self.text(4, y + 12, s, PAL.black)
  end

  def paint
    y = 0
    while y < @mh
      if @rows[y] != nil then self.pixels(0, y, @rows[y]) end
      y += 1
    end
    self.status
  end

  def mouse_down(x, y, b)
    if y >= @mh then return nil end
    cx = @x0 + x * @step
    cy = @y0 + y * @step
    @step = (@step / 2).max(1)
    @x0 = cx - @mw / 2 * @step
    @y0 = cy - @mh / 2 * @step
    self.restart
    self.status
  end

  def menu_items = [
    ["Zoom out", {
      cx = @x0 + @mw / 2 * @step
      cy = @y0 + @mh / 2 * @step
      @step = @step * 2
      @x0 = cx - @mw / 2 * @step
      @y0 = cy - @mh / 2 * @step
      self.restart
      self.status }],
    ["Start again", {
      self.reset
      self.status }]]
end

# ---- Paint --------------------------------------------------------------------------

class Paint < Window
  def init
    @strokes = []
    @swatches = if PAL.color? then [PAL.black, PAL.red, PAL.green, PAL.blue, PAL.yellow, PAL.grey, PAL.white]
                else [PAL.black, PAL.white] end
    @ink = PAL.black
    @last = nil
    p = DESK.place(300, 220)
    super("Paint", p[0], p[1], 300, 220)
  end

  def bar_y = self.height - 18
  def pointer_at(x, y) = if y < self.bar_y then P_CROSS else P_HAND end

  def paint
    for s in @strokes
      self.line(s[1], s[2], s[3], s[4], s[0])
    end
    self.draw_bar
  end

  def draw_bar
    y = self.bar_y
    self.fill(0, y, self.width, 18, PAL.light)
    x = 4
    for c in @swatches
      self.fill(x, y + 3, 16, 12, c)
      self.box(x, y + 3, 16, 12, if c == @ink then PAL.red else PAL.black end)
      x += 20
    end
    self.text(x + 8, y + 13, "right-click: clear", PAL.black)
  end

  def mouse_down(x, y, b)
    if y >= self.bar_y
      i = (x - 4) / 20
      if i >= 0 and i < @swatches.size
        @ink = @swatches[i]
        self.draw_bar
      end
      @last = nil
    else
      @last = [x, y]
    end
  end

  def mouse_drag(x, y)
    if @last == nil then return nil end
    y = y.min(self.bar_y - 1)
    s = [@ink, @last[0], @last[1], x, y]
    @strokes.push(s)
    self.line(s[1], s[2], s[3], s[4], s[0])
    @last = [x, y]
  end

  def mouse_up(x, y, b)
    @last = nil
  end

  def menu_items = [["Clear", { @strokes = []
                                self.invalidate }]]
end

# ---- the Browser: classes, their methods, and the methods' source ----------------

# a scrolling list of strings in part of a window
class ListPane
  def init(win, x, y, w, h)
    @win = win
    @x = x
    @y = y
    @w = w
    @h = h
    @items = []
    @top = 0
    @sel = nil
  end
  attr items, sel

  def set_items(items)
    @items = items
    @top = 0
    @sel = nil
    self.draw
  end

  def rows = @h / 15
  def chars = (@w - 8) / 7
  def hit?(px, py) = px >= @x and px < @x + @w and py >= @y and py < @y + @h

  def draw
    i = 0
    while i < self.rows
      self.draw_row(@top + i)
      i += 1
    end
    @win.fill(@x, @y + self.rows * 15, @w, @h - self.rows * 15, PAL.white)
  end

  def draw_row(k)
    if k < @top or k >= @top + self.rows then return nil end
    y = @y + (k - @top) * 15
    on = k == @sel
    bg = if on then PAL.select else PAL.white end
    @win.fill(@x, y, @w, 15, bg)
    if k < @items.size
      gui_text(@win.id, @x + 4, y + 12, short(@items[k], self.chars),
               if on then PAL.select_text else PAL.black end, bg, MONO)
    end
  end

  def select(k)
    old = @sel
    @sel = k
    if old != nil then self.draw_row(old) end
    self.draw_row(k)
  end

  def row_at(py) = @top + (py - @y) / 15

  # the row clicked, or nil
  def click(px, py)
    k = @top + (py - @y) / 15
    if k >= @items.size then return nil end
    self.select(k)
    k
  end

  def wheel(d)
    t = (@top + 3 * d).max(0).min((@items.size - self.rows).max(0))
    if t != @top
      @top = t
      self.draw
    end
  end
end

# ---- source: where classes and methods come from, and what the
# Workspace has changed since

# the methods compiled in a Workspace, by class name and then selector:
# their lines, as they were run
EDITS = Map.new

# the last line of the block (a class, a def) that starts at lines[i]: the
# lines indented under it, and the end that closes it if it has one
# (gui_indent is a line's leading spaces, -1 if it's blank)
def block_end(lines, i)
  ind = gui_indent(lines[i])
  j = i + 1
  n = lines.size
  while j < n
    k = gui_indent(lines[j])
    if k >= 0 and k <= ind
      if k == ind and lines[j].strip == "end" then return j end
      break
    end
    j += 1
  end
  # no end of its own (a one-line def): the blank lines after it aren't its
  j -= 1
  while j > i and gui_indent(lines[j]) < 0
    j -= 1
  end
  j
end

# the name in "class Name < Super", and the selector in "def name(args)"
def class_name_of(t)
  rest = right_of(t.strip, 6).strip
  k = 0
  while k < rest.size and rest[k] != " " and rest[k] != "<" and rest[k] != "#"
    k += 1
  end
  left_of(rest, k)
end


# [[class name, selector, lines]] for the defs in some code, in class
# statements and at the top level (where they're Object's)
def defs_in(lines)
  out = []
  i = 0
  while i < lines.size
    t = lines[i].strip
    if t.starts_with?("class ")
      e = block_end(lines, i)
      name = class_name_of(t)
      k = i + 1
      while k < e
        sel = gui_def_name(lines[k])
        if sel != nil
          me = block_end(lines, k)
          out.push([name, sel, lines[k..me]])
          k = me + 1
        else
          k += 1
        end
      end
      i = e + 1
    elif t.starts_with?("def ")
      e = block_end(lines, i)
      out.push(["Object", gui_def_name(t), lines[i..e]])
      i = e + 1
    else
      i += 1
    end
  end
  out
end

# what a Workspace compiled: remember the source of its methods
def record_edits(code)
  for d in defs_in(code.split("\n"))
    m = EDITS.get(d[0], nil)
    if m == nil
      m = Map.new
      EDITS[d[0]] = m
    end
    m[d[1]] = d[2]
  end
end

# the source of a method from line `line` of a source (0 the prelude, 1
# what the machine booted with)
def method_source(which, line, sel)
  lines = gui_source_lines(which, line, 200)
  if lines.size == 0 or not lines[0].contains?("def " + sel.to_s) then return nil end
  lines[0..block_end(lines, 0)]
end

# a class's class statements in a source, each as its lines
def class_blocks(which, name)
  out = []
  for n in gui_find_lines(which, "class " + name)
    count = 100
    while true
      lines = gui_source_lines(which, n, count)
      e = block_end(lines, 0)
      if e < lines.size - 1 or lines.size < count or count >= 1000 then break end
      count = (count * 4).min(1000)
    end
    if class_name_of(lines[0]) == name then out.push(lines[0..e]) end
  end
  out
end

# All of a class's source, as lines: its class statements from the prelude
# and from what the machine booted with, with the methods a Workspace has
# changed in their place and the ones it added before the last end
def class_source(cls)
  name = cls.name
  edits = EDITS.get(name, Map.new)
  used = Map.new
  out = []
  blocks = class_blocks(0, name) + class_blocks(1, name)
  for b in blocks
    if out.size > 0 then out.push("") end
    k = 0
    while k < b.size
      l = b[k]
      sel = if k > 0 then gui_def_name(l) else nil end
      if sel != nil and edits.has?(sel)
        out = out + edits[sel]
        used[sel] = true
        k = block_end(b, k) + 1
      else
        out.push(l)
        k += 1
      end
    end
  end
  added = []
  for sel in edits.keys
    if not used.has?(sel)
      added.push("")
      added = added + edits[sel]
    end
  end
  if blocks.size == 0
    if added.size == 0 then return ["# {name} is built into the VM: it has no Egret source."] end
    sup = cls.superclass
    head = "class " + name + if sup == nil or sup == Object then "" else " < " + sup.name end
    return [head] + added.drop(1) + ["end"]
  end
  if added.size > 0 and out.last.strip == "end"
    out.pop
    out = out + added + ["end"]
  end
  out
end

class Browser < Window
  def init
    @classes = gui_globals().select { |g| g[1].is_a?(Class) }.map { |g| g[1] }.sort_by { |c| c.name }
    @cls = nil
    @methods = []
    @source = []
    @stop = 0
    p = DESK.place(460, 330)
    super("Browser", p[0], p[1], 460, 330)
    @left = ListPane(self, 0, 0, 150, 165)
    @right = ListPane(self, 151, 0, 309, 165)
    @left.set_items(@classes.map { |c| c.name })
  end
  def resizable? = false

  def src_y = 186
  def src_rows = (self.height - self.src_y - 2) / 15

  def paint
    @left.draw
    @right.draw
    self.fill(150, 0, 1, 165, PAL.grey)
    self.fill(0, 165, self.width, 1, PAL.grey)
    self.draw_info
    self.draw_source
  end

  def draw_info
    self.fill(0, 166, self.width, 20, PAL.light)
    if @cls == nil
      s = "{@classes.size} classes: pick one"
    else
      sup = if @cls.superclass == nil then "" else " < " + @cls.superclass.name end
      iv = @cls.ivars
      s = @cls.name + sup + if iv.size > 0 then "   @" + iv.join(", @") else "" end
    end
    self.text(4, 180, short(s, 70), PAL.black)
  end

  def draw_source
    i = 0
    while i < self.src_rows
      y = self.src_y + i * 15
      self.fill(0, y, self.width, 15, PAL.white)
      k = @stop + i
      if k < @source.size then gui_text(@id, 4, y + 12, @source[k], PAL.black, PAL.white, MONO) end
      i += 1
    end
  end

  def pick_class(k)
    @cls = @classes[k]
    @methods = gui_methods(@cls).sort_by { |m| m[0].to_s }
    @right.set_items(@methods.map { |m|
      m[0].to_s + if m[3] == 0 then "  (primitive)" elif m[3] == 2 then "  (workspace)" else "" end })
    @source = []
    @stop = 0
    self.draw_info
    self.draw_source
  end

  def source_of(m)
    if m[3] == 0 then return ["# {m[0]} is a primitive, written in C (vm/prims.c", "# or src/gui_prims.c)."] end
    if m[3] == 2
      e = EDITS.get(@cls.name, Map.new).get(m[0].to_s, nil)
      return if e == nil then ["# {m[0]} was defined in a Workspace."] else e end
    end
    src = method_source(1, m[2], m[0])
    if src == nil then src = method_source(0, m[2], m[0]) end
    if src == nil then ["# (no source for {m[0]}: line {m[2]})"] else src end
  end

  def pick_method(k)
    @source = self.source_of(@methods[k])
    @stop = 0
    self.draw_source
  end

  def mouse_down(x, y, b)
    if @left.hit?(x, y)
      k = @left.click(x, y)
      if k != nil then self.pick_class(k) end
    elif @right.hit?(x, y)
      k = @right.click(x, y)
      if k != nil then self.pick_method(k) end
    end
  end

  # a class, or one of its methods, into a Workspace, to change and run
  # again
  def edit_class
    if @cls == nil then return nil end
    gui_pointer(P_BUSY)
    src = class_source(@cls)
    w = Workspace("# Change it, then press Ctrl-D with the cursor in it. (It can't\n" +
                  "# take new instance variables: that needs a new class.)\n\n" + src.join("\n") + "\n")
    w.set_title(@cls.name)
  end

  def edit_method
    if @cls == nil or @right.sel == nil then return nil end
    code = "class " + @cls.name + "\n" + @source.join("\n") + "\nend\n"
    w = Workspace("# Change it, then press Ctrl-D with the cursor in it.\n\n" + code)
    w.set_title(@cls.name + "#" + @methods[@right.sel][0].to_s)
  end

  def double_click(x, y)
    if @left.hit?(x, y)
      if @left.row_at(y) != @left.sel then self.mouse_down(x, y, 0) end
      self.edit_class
    elif @right.hit?(x, y)
      if @right.row_at(y) != @right.sel then self.mouse_down(x, y, 0) end
      self.edit_method
    end
  end

  def menu_items = [
    ["Edit the class", { self.edit_class }],
    ["Edit the method", { self.edit_method }]]

  def wheel(d)
    m = gui_mouse()
    r = self.screen_rect
    x = m[0] - r[0]
    y = m[1] - r[1]
    if @left.hit?(x, y)
      @left.wheel(d)
    elif @right.hit?(x, y)
      @right.wheel(d)
    else
      t = (@stop + 3 * d).max(0).min((@source.size - self.src_rows).max(0))
      if t != @stop
        @stop = t
        self.draw_source
      end
    end
  end
end

# ---- About ------------------------------------------------------------------------------

class About < Window
  def init
    @big = gui_font(30)
    super("About this Heron", 180, 110, 310, 196)
  end
  def resizable? = false

  def paint
    w = self.width
    self.text_in(@big, 20, 44, "Heron", PAL.title, @bg)
    self.text(120, 36, "draft 1b, 3 MHz", PAL.shadow)
    s = gui_stats()
    y = 70
    for line in ["A Smalltalk-style desktop written in Egret,",
                 "compiled and run by the machine itself.",
                 "",
                 "Classes and code: {s[0] / 1024} of {s[1] / 1024} KB",
                 "Objects: {s[2] / 1024} of {s[3] / 1024} KB, {s[4]} collections",
                 "Machine time: {clock_seconds()} s"]
      self.text(20, y, line, PAL.black)
      y += 18
    end
    self.text(20, y + 8, "Click the desktop for the menu.", PAL.accent)
  end
end

def clock_seconds = gui_ticks() / 60
