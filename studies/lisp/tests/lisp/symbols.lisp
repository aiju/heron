; Symbols and strings, property lists, gensym, and vectors: every
; procedure in those tables of the spec.

(define (show label x)
  (display label)
  (display ": ")
  (write x)
  (newline))

; ---- symbols and strings
(show "symbol->string" (symbol->string 'hello))
(show "symbol->string of t" (symbol->string t))
(show "symbol->string of punctuation" (symbol->string 'set-car!))
(show "string->symbol" (string->symbol "abc"))
(show "string->symbol is interned" (eq? (string->symbol "abc") 'abc))
(show "a round trip" (eq? (string->symbol (symbol->string 'xyz)) 'xyz))
(show "string->symbol of t" (eq? (string->symbol "t") t))
(show "a symbol with a space" (string->symbol "a b"))
(show "string-length" (list (string-length "") (string-length "abc") (string-length "a\nb")))
(show "string-ref" (list (string-ref "abc" 0) (string-ref "abc" 2) (string-ref "A" 0) (string-ref " " 0)))
(show "string-ref of a high byte" (string-ref "é" 0))
(show "string=?" (list (string=? "abc" "abc") (string=? "abc" "abd") (string=? "" "") (string=? "ab" "abc") (string=? "abc" "ab")))
(show "string=? of a symbol's name" (string=? (symbol->string 'foo) "foo"))
(show "string=? is case-sensitive" (string=? "abc" "ABC"))
(define (string->list s)
  (let loop ((i (- (string-length s) 1)) (acc nil))
    (if (< i 0) acc (loop (- i 1) (cons (string-ref s i) acc)))))
(show "the codes of a string" (string->list "Lisp!"))
(define (print-codes codes) (for-each write-char codes))
(display "write-char of those: ")
(print-codes (string->list "Lisp!"))
(newline)

; ---- gensym
(define sym1 (gensym))
(define sym2 (gensym))
(show "gensyms" (list sym1 sym2))
(show "a gensym is a symbol" (symbol? sym1))
(show "gensyms differ" (eq? sym1 sym2))
(show "a gensym is not interned" (eq? sym1 'g1))
(show "its name" (symbol->string sym1))
(show "its name interned" (eq? (string->symbol (symbol->string sym1)) 'g1))
(show "a third" (gensym))
(show "a gensym bound by eval" (eval (list 'let (list (list sym1 5)) (list '* sym1 sym1))))
(show "a gensym as a global" (begin (eval (list 'define sym2 ''global)) (eval sym2)))
(show "a gensym's properties" (begin (put sym2 'k 'v) (get sym2 'k)))
(show "a gensym is equal? to itself only" (list (equal? sym1 sym1) (equal? sym1 'g1)))

; ---- property lists
(show "get with nothing" (get 'apple 'color))
(show "put returns the value" (put 'apple 'color 'red))
(show "get" (get 'apple 'color))
(put 'apple 'weight 150)
(show "two properties" (list (get 'apple 'color) (get 'apple 'weight)))
(put 'apple 'color 'green)
(show "put replaces" (list (get 'apple 'color) (get 'apple 'weight)))
(show "other symbols unaffected" (get 'pear 'color))
(put 'apple 3 'three)
(show "an integer key" (get 'apple 3))
(put 'apple '(k) 'list-key)
(show "keys compare with eq?" (get 'apple '(k)))
(define key '(k))
(put 'apple key 'same-list)
(show "the same list as key" (get 'apple key))
(put 'apple 'nothing nil)
(show "a nil value" (get 'apple 'nothing))
(show "a property of t" (begin (put t 'p 1) (get t 'p)))
(define apple 'its-value)
(show "the value and the properties are separate" (list apple (get 'apple 'weight)))
(define (count-props sym keys)
  (let loop ((ks keys) (n 0))
    (cond ((null? ks) n)
          ((get sym (car ks)) (loop (cdr ks) (+ n 1)))
          (t (loop (cdr ks) n)))))
(show "properties set" (count-props 'apple '(color weight 3 nothing size)))
(define (put-squares n) (do ((i 0 (+ i 1))) ((= i n)) (put 'squares i (* i i))))
(put-squares 50)
(show "50 integer keys" (list (get 'squares 0) (get 'squares 7) (get 'squares 49) (get 'squares 50)))

; ---- vectors
(define v (make-vector 5 0))
(show "make-vector" v)
(show "vector-length" (vector-length v))
(show "vector-set! returns the value" (vector-set! v 2 'two))
(show "vector-ref" (vector-ref v 2))
(vector-set! v 0 "zero")
(vector-set! v 4 '(4))
(show "after vector-set!" v)
(show "first and last" (list (vector-ref v 0) (vector-ref v 4)))
(show "an empty vector" (make-vector 0 'x))
(show "its length" (vector-length (make-vector 0 'x)))
(show "the fill is shared" (let ((w (make-vector 2 (list 1)))) (eq? (vector-ref w 0) (vector-ref w 1))))
(define (squares! w)
  (do ((i 0 (+ i 1))) ((= i (vector-length w)) w) (vector-set! w i (* i i))))
(show "filled" (squares! (make-vector 10 0)))
(show "a vector of vectors"
      (let ((m (make-vector 2 nil)))
        (vector-set! m 0 (make-vector 2 0))
        (vector-set! m 1 (make-vector 2 1))
        m))
(define big (make-vector 10000 1))
(vector-set! big 9999 'last)
(show "a large vector" (list (vector-length big) (vector-ref big 0) (vector-ref big 9999)))
(show "a vector is eq? to itself" (eq? v v))
(show "done" 'symbols)
