; Pairs and lists, predicates and equality: every procedure in those two
; tables of the spec, on ordinary and edge-case arguments.

(define (show label x)
  (display label)
  (display ": ")
  (write x)
  (newline))

(define (label s) (display s) (display ": "))

; ---- pairs
(show "cons" (cons 1 2))
(show "cons onto a list" (cons 1 '(2 3)))
(show "cons onto nil" (cons 1 nil))
(show "car" (car '(a b c)))
(show "cdr" (cdr '(a b c)))
(show "cdr of a 1-list" (cdr '(a)))
(show "cdr of a dotted pair" (cdr '(a . b)))
(define p (cons 1 2))
(show "set-car! returns the value" (set-car! p 'x))
(show "set-cdr! returns the value" (set-cdr! p '(y z)))
(show "after both" p)
(define nested '((1 2) (3 4) 5 6 7))
(show "caar" (caar nested))
(show "cadr" (cadr nested))
(show "cdar" (cdar nested))
(show "cddr" (cddr nested))
(show "caddr" (caddr nested))
(show "cdddr" (cdddr nested))
(show "cadddr" (cadddr nested))

; ---- lists
(show "list" (list 1 'two "three" '(4)))
(show "empty list" (list))
(show "list of nils" (list nil nil))
(show "length" (length '(1 2 3)))
(show "length nil" (length nil))
(show "length of nested" (length '((1 2) (3 4 5))))
(show "append" (append '(1 2) '(3 4) '(5)))
(show "append nothing" (append))
(show "append one" (append '(1 2)))
(show "append with nil" (append nil '(1) nil '(2) nil))
(show "append onto an atom" (append '(1 2) 3))
(show "append returns an atom" (append nil 'a))
(define tail '(3 4))
(define joined (append '(1 2) tail))
(show "append shares the last list" (eq? (cddr joined) tail))
(define front '(1 2))
(define copied (append front '(3)))
(set-car! copied 'changed)
(show "append copies the others" front)
(show "reverse" (reverse '(1 2 3 4)))
(show "reverse nil" (reverse nil))
(show "reverse nested" (reverse '((1 2) (3 4))))
(show "list-tail" (list-tail '(a b c d) 2))
(show "list-tail 0" (list-tail '(a b c d) 0))
(show "list-tail to the end" (list-tail '(a b c d) 4))
(show "list-ref" (list-ref '(a b c d) 2))
(show "list-ref 0" (list-ref '(a b c d) 0))
(show "last-pair" (last-pair '(1 2 3)))
(show "last-pair dotted" (last-pair '(1 2 . 3)))
(show "last-pair of one" (last-pair '(1)))

; ---- searching
(show "memq" (memq 'c '(a b c d)))
(show "memq missing" (memq 'z '(a b c d)))
(show "memq integers" (memq 3 '(1 2 3 4)))
(show "memq nil" (memq nil '(a nil b)))
(show "memq a list" (memq '(1) '((1) (2))))
(show "member a list" (member '(1) '((0) (1) (2))))
(show "member a string" (member "b" '("a" "b" "c")))
(show "member missing" (member '(9) '((1) (2))))
(define al '((a . 1) (b . 2) ((c) . 3) ("d" . 4)))
(show "assq" (assq 'b al))
(show "assq missing" (assq 'z al))
(show "assq a list key" (assq '(c) al))
(show "assoc a list key" (assoc '(c) al))
(show "assoc a string key" (assoc "d" al))
(show "assq an integer key" (assq 2 '((1 . one) (2 . two))))
(show "assq empty" (assq 'a nil))

; ---- map and for-each
(show "map" (map (lambda (v) (* v v)) '(1 2 3 4)))
(show "map car" (map car '((a 1) (b 2))))
(show "map nil" (map car nil))
(show "map a primitive" (map list '(1 2 3)))
(label "map in order")
(write (map (lambda (v) (display v) (display " ") (+ v 1)) '(1 2 3)))
(newline)
(label "for-each")
(write (for-each (lambda (v) (display v) (display " ")) '(a b c)))
(newline)
(show "for-each nil" (for-each car nil))
(define long (let loop ((i 0) (acc nil)) (if (= i 200) acc (loop (+ i 1) (cons i acc)))))
(show "map on 200" (apply + (map (lambda (v) (+ v 1)) long)))
(show "reverse 200" (car (reverse long)))
(show "append 200 and 200" (length (append long long)))
(show "member at the end of 200" (member '(0) (map list long)))

; ---- predicates
(show "eq? symbols" (eq? 'a 'a))
(show "eq? different symbols" (eq? 'a 'b))
(show "eq? integers" (eq? 100000 100000))
(show "eq? negative integers" (eq? -1073741824 -1073741824))
(show "eq? nil ()" (eq? nil '()))
(show "eq? lists" (eq? '(1) '(1)))
(show "eq? same list" (let ((l '(1))) (eq? l l)))
(show "eq? strings" (eq? "a" "a"))
(show "eq? same string" (let ((s "a")) (eq? s s)))
(show "eq? primitives" (eq? car car))
(show "eq? 1 and t" (eq? 1 t))
(show "equal? lists" (equal? '(1 (2 "three") . 4) '(1 (2 "three") . 4)))
(show "equal? different lists" (equal? '(1 2) '(1 2 3)))
(show "equal? strings" (equal? "abc" "abc"))
(show "equal? different strings" (equal? "abc" "abd"))
(show "equal? integers" (equal? 7 7))
(show "equal? vectors" (equal? (make-vector 1 0) (make-vector 1 0)))
(define v (make-vector 1 0))
(show "equal? same vector" (equal? v v))
(show "equal? nil" (equal? nil nil))
(show "equal? symbol and string" (equal? 'a "a"))
(show "not" (list (not nil) (not t) (not 0) (not '())))
(show "null?" (list (null? nil) (null? '(1)) (null? 0)))
(show "pair?" (list (pair? '(1)) (pair? nil) (pair? 'a) (pair? '(1 . 2))))
(show "atom?" (list (atom? '(1)) (atom? nil) (atom? 'a) (atom? 5) (atom? "s")))
(show "symbol?" (list (symbol? 'a) (symbol? nil) (symbol? t) (symbol? "a") (symbol? 1)))
(show "number?" (list (number? 1) (number? -5) (number? 'a) (number? "1")))
(show "integer?" (list (integer? 0) (integer? nil)))
(show "string?" (list (string? "") (string? 'a) (string? nil)))
(show "vector?" (list (vector? (make-vector 0 0)) (vector? '(1)) (vector? nil)))
(show "procedure?" (list (procedure? car) (procedure? (lambda () 1)) (procedure? 'car) (procedure? nil)))
(show "list?" (list (list? nil) (list? '(1 2)) (list? '(1 . 2)) (list? 5) (list? '(1 2 . 3))))
(show "eof-object?" (list (eof-object? nil) (eof-object? 'eof) (eof-object? 0)))
(show "done" 'lists)
