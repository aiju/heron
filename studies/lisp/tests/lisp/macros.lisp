; Macros: defmacro (fixed, dotted and rest parameters), macros that expand
; into other macros, macros used inside procedures, and the prelude's
; macros: quasiquote (with unquote and unquote-splicing), when, unless, do
; and case.

(define (show label x)
  (display label)
  (display ": ")
  (write x)
  (newline))

(define (label s) (display s) (display ": "))

; ---- quasiquote
(define x 5)
(define l '(a b c))
(show "no unquotes" `(1 2 3))
(show "an atom" `foo)
(show "an integer" `7)
(show "unquote" `(x is ,x))
(show "unquote an expression" `(sum ,(+ x 1) ,(* x 2)))
(show "unquote alone" `,x)
(show "splice" `(start ,@l end))
(show "splice at the start" `(,@l end))
(show "splice at the end" `(start ,@l))
(show "splice alone" `(,@l))
(show "splice nil" `(start ,@nil end))
(show "splice an expression" `(1 ,@(map (lambda (v) (* v v)) '(2 3)) 4))
(show "two splices" `(,@l ,@l))
(show "nested lists" `((a ,x) (b ,@l) (c (d ,x))))
(show "dotted tail" `(1 . ,x))
(show "dotted tail, list" `(1 2 . ,l))
(show "quote inside" `(quote ,x))
(show "quoted symbol inside" `(a 'b ,x))
(show "unquote a list" `(,l))
(show "unquote a string" `(,"s" "t"))
(define (make-adder-form n) `(lambda (v) (+ v ,n)))
(show "build code" (make-adder-form 3))
(show "and run it" ((eval (make-adder-form 3)) 4))
(define spliced '(2 3))
(define result `(1 ,@spliced 4))
(set-car! (cdr result) 'changed)
(show "splicing copies" spliced)
(label "unquotes left to right")
(write `(,(begin (display "a") 1) ,@(begin (display "b") '(2)) ,(begin (display "c") 3)))
(newline)

; ---- defmacro
(show "defmacro returns the name" (defmacro my-if (c a b) `(cond (,c ,a) (t ,b))))
(show "my-if true" (my-if t 'yes 'no))
(show "my-if false" (my-if nil (car 5) 'no))
(defmacro quote-it (v) (list 'quote v))
(show "operands are not evaluated" (quote-it (car 5)))
(defmacro my-list (first . rest) `(list ',first ,@rest))
(show "dotted parameters" (my-list a 1 2 3))
(show "dotted, no rest" (my-list a))
(defmacro all-args args `(quote ,args))
(show "rest parameter" (all-args 1 (2) three))
(show "rest parameter, none" (all-args))
(defmacro my-when (c . body) `(if ,c (begin ,@body) nil))
(defmacro my-unless (c . body) `(my-when (not ,c) ,@body))
(show "a macro expanding to a macro" (my-unless nil 1 2 3))
(show "and false" (my-unless t 1 2 3))
(defmacro my-or2 (a b) `(let ((tmp ,a)) (if tmp tmp ,b)))
(show "expands to let" (my-or2 nil 7))
(define (helper-expander v) `(* ,v ,v))
(defmacro sq (v) (helper-expander v))
(show "an expander calling a procedure" (sq 9))
(define (use-sq n) (+ (sq n) 1))
(show "a macro inside a procedure" (list (use-sq 2) (use-sq 3) (use-sq 4)))
(defmacro while (test . body)
  `(let lp () (when ,test ,@body (lp))))
(define i 0)
(define acc nil)
(while (< i 5) (set! acc (cons i acc)) (set! i (+ i 1)))
(show "while" acc)
(define (count-down n)
  (let ((out nil))
    (while (> n 0) (set! out (cons n out)) (set! n (- n 1)))
    out))
(show "while in a procedure" (list (count-down 3) (count-down 2)))
(defmacro inc! (var . by)
  (if (null? by) `(set! ,var (+ ,var 1)) `(set! ,var (+ ,var ,(car by)))))
(define n 10)
(inc! n)
(inc! n 5)
(show "optional macro argument" n)
(defmacro swap! (a b)
  (let ((tmp (gensym)))
    `(let ((,tmp ,a)) (set! ,a ,b) (set! ,b ,tmp))))
(define p 1)
(define q 2)
(swap! p q)
(show "swap! with a gensym" (list p q))
(defmacro my-let1 (var val . body) `((lambda (,var) ,@body) ,val))
(show "expands to a lambda call" (my-let1 v 4 (* v v)))
(show "a macro in tail position" (let loop ((k 0)) (my-if (= k 10000) k (loop (+ k 1)))))

; ---- when, unless
(show "when true" (when t 1 2 3))
(show "when false" (when nil (car 5)))
(show "when, no body" (when t))
(show "unless false" (unless nil 1 2 3))
(show "unless true" (unless t (car 5)))
(label "when runs the body in order")
(write (when 1 (display "a") (display "b") 'c))
(newline)

; ---- do
(show "do" (do ((k 0 (+ k 1)) (acc nil (cons k acc))) ((= k 5) acc)))
(show "do, no result" (do ((k 0 (+ k 1))) ((= k 3))))
(show "do, several results" (do ((k 0 (+ k 1))) ((= k 3) 'a 'b k)))
(label "do with a body")
(do ((k 0 (+ k 1))) ((= k 4) (newline)) (display k) (display " "))
(show "do, a variable without a step" (do ((k 0 (+ k 1)) (fixed 'same)) ((= k 3) fixed)))
(show "do, the body changes a stepless variable"
      (do ((k 0 (+ k 1)) (s 0)) ((= k 4) s) (set! s (+ s k))))
(show "do, steps see the old values"
      (do ((a 0 b) (b 1 (+ a b)) (k 0 (+ k 1))) ((= k 10) (list a b))))
(show "do, inits see the outer scope" (let ((k 'outer)) (do ((k 0 (+ k 1)) (first k)) ((= k 2) first))))
(show "do, closures capture each iteration"
      (map (lambda (f) (f))
           (do ((k 0 (+ k 1)) (fs nil (cons (lambda () k) fs))) ((= k 3) fs))))
(show "do, no variables" (let ((c 0)) (do () ((= c 3) c) (set! c (+ c 1)))))
(show "do, 100000 times" (do ((k 0 (+ k 1)) (s 0 (+ s 1))) ((= k 100000) s)))
(show "nested do"
      (do ((a 0 (+ a 1)) (out nil (cons (do ((b 0 (+ b 1)) (r nil (cons (list a b) r))) ((= b 2) r)) out)))
          ((= a 2) out)))

; ---- case
(define (classify v)
  (case v
    ((1 2 3) 'small)
    ((4 5 6) 'medium)
    ((a b) 'letter)
    ((nil) 'nothing)
    (t 'other)))
(show "case" (map classify '(1 5 a 9 z nil)))
(show "case, no match" (case 'z ((a) 1) ((b) 2)))
(show "case, several forms" (case 2 ((1) 'one) ((2) (display "") 'two-a 'two)))
(show "case evaluates the key once" (let ((c 0)) (case (begin (set! c (+ c 1)) c) ((5) 'five) ((6) 'six) (t c))))
(show "case on a computed key" (case (* 2 3) ((6) 'six) (t 'other)))
(show "case, large integers" (case 1000000 ((1000000) 'million) (t 'no)))
(show "case, no clauses" (case 1))
(show "done" 'macros)
