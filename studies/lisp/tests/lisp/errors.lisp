; Errors: every message in the spec's error table, each in its own
; top-level form after a line saying what it is, so the program carries on
; after each one. Also which argument is reported when several are wrong,
; the order of evaluating, checking and applying a call, what an abandoned
; form leaves behind, and (last) an unterminated list, which ends the
; program.

(define (show label x)
  (display label)
  (display ": ")
  (write x)
  (newline))

(define (note s) (display s) (newline))

; ---- not a pair
(note "car of an integer")
(car 5)
(note "cdr of a symbol")
(cdr 'a)
(note "car of nil")
(car nil)
(note "car of a string")
(car "str")
(note "set-car! of nil")
(set-car! nil 1)
(note "set-cdr! of a vector")
(set-cdr! (make-vector 1 0) 1)
(note "cadr of a 1-list")
(cadr '(1))
(note "caddr of a 2-list")
(caddr '(1 2))
(note "cdar of a list of atoms")
(cdar '(1 2))
(note "cadddr of a dotted list")
(cadddr '(1 2 . 3))
(note "list-ref past the end")
(list-ref '(a b) 5)
(note "last-pair of nil")
(last-pair nil)

; ---- not a list
(note "length of a dotted list")
(length '(1 2 . 3))
(note "length of an integer")
(length 5)
(note "reverse of a dotted list")
(reverse '(1 . 2))
(note "append of a dotted list")
(append '(1 . 2) '(3))
(note "append with an atom in the middle")
(append '(1) 2 '(3))
(note "apply to a dotted list")
(apply + '(1 2 . 3))
(note "apply to an integer")
(apply + 5)
(note "map over a dotted list")
(map car '((1) . 5))
(note "for-each over an integer")
(for-each display 7)
(note "memq in a dotted list")
(memq 'z '(a b . c))

; ---- not a number
(note "+ with a symbol")
(+ 1 'a)
(note "+ with a symbol first")
(+ 'a 1)
(note "- of a string")
(- "s")
(note "* with nil")
(* 2 nil)
(note "< with a symbol")
(< 1 'x)
(note "> with a symbol first")
(> 'y 1)
(note "= with a string")
(= 1 "1")
(note "zero? of a symbol")
(zero? 'z)
(note "abs of a list")
(abs '(1))
(note "min with a symbol")
(min 1 'm)
(note "quotient of a symbol")
(quotient 'q 1)
(note "remainder by a symbol")
(remainder 1 'r)
(note "modulo of a symbol by zero")
(modulo 'm 0)
(note "logand with a symbol")
(logand 1 'b)
(note "logior with a symbol first")
(logior 'a 1)
(note "logxor with nil")
(logxor 1 nil)
(note "ash of a symbol")
(ash 'n 1)
(note "ash by a symbol")
(ash 1 'k)
(note "vector-ref with a symbol index")
(vector-ref (make-vector 2 0) 'k)
(note "make-vector of a symbol size")
(make-vector 'n 0)
(note "string-ref with a symbol index")
(string-ref "abc" 'k)
(note "write-char of a symbol")
(write-char 'c)
(note "list-tail by a symbol")
(list-tail '(1 2) 'k)

; ---- not a procedure
(note "an integer as operator")
(5 1)
(note "a quoted symbol as operator")
('foo)
(note "a string as operator")
("str" 1)
(note "nil as operator")
(nil)
(note "a computed operator")
((car '(1 2)) 3)
(note "apply an integer")
(apply 5 '(1))
(note "map an integer")
(map 5 '(1))

; ---- not a symbol, not a string, not a vector
(note "symbol->string of a string")
(symbol->string "abc")
(note "symbol->string of nil")
(symbol->string nil)
(note "get on a string")
(get "x" 'k)
(note "put on an integer")
(put 5 'k 1)
(note "string-length of a symbol")
(string-length 'abc)
(note "string->symbol of an integer")
(string->symbol 5)
(note "string-ref of a symbol")
(string-ref 'abc 0)
(note "string=? with a symbol second")
(string=? "a" 'a)
(note "string=? with a symbol first")
(string=? 'a "a")
(note "vector-ref of a list")
(vector-ref '(1 2) 0)
(note "vector-set! of a string")
(vector-set! "s" 0 1)
(note "vector-length of nil")
(vector-length nil)

; ---- unbound variable
(note "a variable")
undefined-thing
(note "an operator")
(undefined-function 1 2)
(note "else is not special")
(cond (else 1))
(note "out of scope")
(let ((a 1)) b)
(note "a parameter is not visible in the caller")
(define (f param) param)
(f 1)
param

; ---- wrong number of arguments
(note "car of nothing")
(car)
(note "car of two")
(car '(1) '(2))
(note "cons of one")
(cons 1)
(note "- of nothing")
(-)
(note "< of three")
(< 1 2 3)
(note "= of one")
(= 1)
(note "abs of two")
(abs 1 2)
(note "min of one")
(min 1)
(note "newline of one")
(newline 1)
(note "a lambda given too few")
((lambda (x) x))
(note "a lambda given too many")
((lambda (x) x) 1 2)
(note "a dotted lambda given too few")
((lambda (x y . r) x) 1)
(note "a define given too many")
(define (two a b) (list a b))
(two 1 2 3)
(note "error of nothing")
(error)
(note "apply car to two")
(apply car '(1 2))
(note "a macro given too few")
(defmacro two-args (a b) (list 'quote (list a b)))
(two-args 1)
(note "when of nothing")
(when)

; ---- division by zero
(note "quotient")
(quotient 1 0)
(note "remainder")
(remainder 1 0)
(note "modulo")
(modulo 1 0)
(note "zero by zero")
(quotient 0 0)

; ---- index out of range
(note "vector-ref at the length")
(vector-ref (make-vector 3 0) 3)
(note "vector-ref at -1")
(vector-ref (make-vector 3 0) -1)
(note "vector-set! past the end")
(vector-set! (make-vector 3 0) 5 'x)
(note "vector-ref of an empty vector")
(vector-ref (make-vector 0 0) 0)
(note "string-ref at the length")
(string-ref "abc" 3)
(note "string-ref of an empty string")
(string-ref "" 0)
(note "string-ref at -1")
(string-ref "abc" -1)
(note "make-vector of -1")
(make-vector -1 0)

; ---- overflow (arith.lisp has the rest)
(note "a sum")
(+ 1073741823 1)
(note "a literal")
1073741824

; ---- bad syntax
(note "if of nothing")
(if)
(note "if of one")
(if t)
(note "if of four")
(if t 1 2 3)
(note "quote of nothing")
(quote)
(note "quote of two")
(quote 1 2)
(note "define of nothing")
(define)
(note "define without a value")
(define x)
(note "define of an integer")
(define 5 1)
(note "define of two values")
(define x 1 2)
(note "define with an integer parameter")
(define (g 1) 1)
(note "set! without a value")
(set! x)
(note "set! of an integer")
(set! 5 1)
(note "lambda of nothing")
(lambda)
(note "lambda with an integer parameter")
(lambda (1) 1)
(note "lambda with an integer rest")
(lambda (a . 5) 1)
(note "let binding without a value")
(let ((x)) x)
(note "let binding an integer")
(let ((1 2)) 1)
(note "let binding with two values")
(let ((x 1 2)) x)
(note "named let without bindings")
(let x)
(note "let of nothing")
(let)
(note "let* binding a bare symbol")
(let* (x) x)
(note "letrec binding with two values")
(letrec ((x 1 2)) x)
(note "cond with an atom clause")
(cond 5)
(note "cond with an empty clause")
(cond ())
(note "defmacro of nothing")
(defmacro)
(note "defmacro of an integer")
(defmacro 5 (x) x)

; ---- unexpected )
(note "a stray )")
)
(note "a quote of )")
')
(note "still reading")

; ---- error
(note "a message and irritants")
(error "my message" '(1 2) 'foo)
(note "a message alone")
(error "no irritants")
(note "irritants are written")
(error "a string irritant" "s\"q")
(note "several irritants")
(error "several" 1 -2 'three "four" '(5 . 6) nil t)
(note "a procedure irritant")
(error "a procedure" car)
(note "from inside a function")
(define (check-positive n) (if (< n 0) (error "negative" n) n))
(check-positive -3)
(show "and when there's no error" (check-positive 3))

; ---- which argument is reported
(note "the first of two bad arguments")
(+ 1 'a 'b)
(note "the vector before the index")
(vector-ref 5 'x)
(note "the string before the index")
(string-ref 5 'x)
(note "the type before division by zero")
(quotient 'a 0)
(note "an operand's own error comes first")
(+ (car nil) 'a)

; ---- the order of evaluating, checking and applying a call
(note "operator and operands are evaluated before the operator is checked")
((begin (display "operator ") 5) (begin (display "operand") (newline) 1))
(note "an operand's error before a bad operator")
(5 (car nil))
(note "an unbound operator before the operands")
(undefined-fn (car nil))
(note "operands are evaluated before the arity check")
((lambda (x) x) (begin (display "evaluated") (newline) 1) 2)

; ---- what an abandoned form leaves behind
(define state 'before)
(note "an error in the middle of a begin")
(begin (set! state 'during) (car 5) (set! state 'after))
(show "state after an error" state)
(note "a define whose value fails")
(define z (car 5))
(note "leaves the variable unbound")
z
(define (deep n) (if (= n 0) (car 'bottom) (+ 1 (deep (- n 1)))))
(note "an error 50 calls deep")
(deep 50)
(note "the error line follows the output on the same line")
(begin (display "partial output ") (car 5))
(show "carrying on" 'yes)

; ---- the end of the input inside a datum ends the program
(note "an unterminated list")
(display "never printed"
(display "nor this")
