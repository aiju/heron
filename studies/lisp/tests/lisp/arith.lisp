; Arithmetic on 31-bit fixnums: every procedure in the arithmetic table,
; the signs of quotient, remainder and modulo, bitwise operations on
; negative numbers, ash both ways, and overflow at every edge (each
; overflow in its own top-level form).

(define (show label x)
  (display label)
  (display ": ")
  (write x)
  (newline))

(define (note s) (display s) (newline))

(define max-fix 1073741823)
(define min-fix -1073741824)

; ---- literals
(show "largest" 1073741823)
(show "smallest" -1073741824)
(show "plus sign" +5)
(show "minus zero" -0)
(show "plus zero" +0)
(show "leading zeros" 007)
(show "negative leading zeros" -0012)
(show "many leading zeros" 000000000000000000001)

; ---- + - *
(show "+" (+ 1 2))
(show "+ none" (+))
(show "+ one" (+ 5))
(show "+ negative" (+ -5 3))
(show "+ to the largest" (+ 1073741822 1))
(show "+ to the smallest" (+ -1073741823 -1))
(show "+ largest and smallest" (+ max-fix min-fix))
(show "-" (- 10 3))
(show "- one" (- 5))
(show "- several" (- 10 1 2 3))
(show "- of the largest" (- max-fix))
(show "- to the smallest" (- -1073741823 1))
(show "- to the largest" (- 0 max-fix))
(show "*" (* 6 7))
(show "* none" (*))
(show "* one" (* 9))
(show "* negative" (* -6 7))
(show "* two negatives" (* -6 -7))
(show "* zero" (* 0 max-fix))
(show "* to the smallest" (* 32768 -32768))
(show "* near the largest" (* 32767 32769))
(show "* the smallest by 1" (* min-fix 1))
(show "* the largest by -1" (* max-fix -1))

; ---- overflow, one form each, after a line saying what it is
(note "(+ 1073741823 1)")
(+ 1073741823 1)
(note "(+ -1073741824 -1)")
(+ -1073741824 -1)
(note "(+ max-fix max-fix)")
(+ max-fix max-fix)
(note "(+ 1073741823 1 -1)")
(+ 1073741823 1 -1)
(note "(- -1073741824 1)")
(- -1073741824 1)
(note "(- -1073741824)")
(- -1073741824)
(note "(- max-fix -1)")
(- max-fix -1)
(note "(- 0 min-fix)")
(- 0 min-fix)
(note "(* 32768 32768)")
(* 32768 32768)
(note "(* -32768 -32768)")
(* -32768 -32768)
(note "(* min-fix -1)")
(* min-fix -1)
(note "(* 2 3 178956971)")
(* 2 3 178956971)
(note "(quotient -1073741824 -1)")
(quotient -1073741824 -1)
(note "(abs -1073741824)")
(abs -1073741824)
(note "(ash 1 30)")
(ash 1 30)
(note "(ash 1 31)")
(ash 1 31)
(note "(ash 1 100)")
(ash 1 100)
(note "(ash -1 31)")
(ash -1 31)
(note "(ash 3 29)")
(ash 3 29)
(note "(ash max-fix 1)")
(ash max-fix 1)
(note "1073741824")
1073741824
(note "-1073741825")
-1073741825
(note "99999999999999999999")
99999999999999999999
(show "still running" 'yes)

; ---- quotient, remainder, modulo
(show "quotient" (list (quotient 17 5) (quotient -17 5) (quotient 17 -5) (quotient -17 -5)))
(show "remainder" (list (remainder 17 5) (remainder -17 5) (remainder 17 -5) (remainder -17 -5)))
(show "modulo" (list (modulo 17 5) (modulo -17 5) (modulo 17 -5) (modulo -17 -5)))
(show "exact" (list (quotient 15 5) (remainder -15 5) (modulo -15 5) (modulo 15 -5)))
(show "small by large" (list (quotient 3 7) (remainder -3 7) (modulo -3 7) (modulo 3 -7)))
(show "zero dividend" (list (quotient 0 -3) (remainder 0 -3) (modulo 0 -3)))
(show "smallest by -1" (list (remainder min-fix -1) (modulo min-fix -1)))
(show "smallest by 1" (list (quotient min-fix 1) (remainder min-fix 1)))
(show "smallest by 2" (list (quotient min-fix 2) (remainder min-fix 2) (modulo min-fix 2)))
(show "largest by -2" (list (quotient max-fix -2) (remainder max-fix -2) (modulo max-fix -2)))
(show "smallest by largest" (list (quotient min-fix max-fix) (remainder min-fix max-fix) (modulo min-fix max-fix)))
(show "largest by smallest" (list (quotient max-fix min-fix) (remainder max-fix min-fix) (modulo max-fix min-fix)))

; ---- comparisons
(show "=" (list (= 1 1) (= 1 2) (= -5 -5) (= min-fix min-fix)))
(show "<" (list (< 1 2) (< 2 1) (< 1 1) (< min-fix max-fix) (< -1 0)))
(show ">" (list (> 1 2) (> 2 1) (> 1 1) (> max-fix min-fix)))
(show "<=" (list (<= 1 2) (<= 2 1) (<= 1 1)))
(show ">=" (list (>= 1 2) (>= 2 1) (>= 1 1)))
(show "zero?" (list (zero? 0) (zero? 1) (zero? -1) (zero? -0)))

; ---- abs, min, max
(show "abs" (list (abs 5) (abs -5) (abs 0) (abs max-fix) (abs -1073741823)))
(show "min" (list (min 1 2) (min 2 1) (min -3 3) (min min-fix max-fix)))
(show "max" (list (max 1 2) (max 2 1) (max -3 3) (max min-fix max-fix)))

; ---- bitwise
(show "logand" (logand 12 10))
(show "logior" (logior 12 10))
(show "logxor" (logxor 12 10))
(show "logand -1" (logand -1 255))
(show "logand negatives" (logand -8 -3))
(show "logior negative" (logior -8 3))
(show "logxor negative" (logxor -1 5))
(show "logxor -1 largest" (logxor -1 max-fix))
(show "logxor smallest -1" (logxor min-fix -1))
(show "logand smallest" (logand min-fix -1))
(show "logior smallest largest" (logior min-fix max-fix))
(show "logand smallest largest" (logand min-fix max-fix))

; ---- ash
(show "ash left" (ash 1 10))
(show "ash 0" (ash 5 0))
(show "ash to bit 29" (ash 1 29))
(show "ash -1 to the smallest" (ash -1 30))
(show "ash 0 far" (ash 0 100))
(show "ash negative left" (ash -3 4))
(show "ash right" (ash 1024 -3))
(show "ash right rounds down" (ash 7 -1))
(show "ash right negative" (ash -7 -1))
(show "ash right -1" (ash -1 -5))
(show "ash right far" (ash max-fix -100))
(show "ash right far negative" (ash min-fix -100))
(show "ash smallest right 30" (ash min-fix -30))
(show "ash largest right 29" (ash max-fix -29))

; ---- a computation that stays in range
(define (sum-to n) (let loop ((i 1) (s 0)) (if (> i n) s (loop (+ i 1) (+ s i)))))
(show "sum to 46340" (sum-to 46340))
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(show "12!" (fact 12))
(note "(fact 13)")
(fact 13)
(show "done" 'arith)
