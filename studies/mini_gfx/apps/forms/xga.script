# The forms application's script for 1024 x 768 (M5, M6): prog.toml's,
# with the clicks where the windows are in that layout (the record window
# and the chart are open from the start, the list has 26 rows).
#
#   heron mini_gfx run apps/forms --poke mode=5 --layout L1 \
#       --script studies/mini_gfx/apps/forms/xga.script

